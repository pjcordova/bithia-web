# Copia este archivo como .env y rellena los valores.
# .env está en .gitignore — nunca se sube al repositorio.

# --- Base de datos (Neon) ---------------------------------------------------
# Panel de Neon > proyecto bithia-web > Connection string (pooled).
# Debe terminar en ?sslmode=require
DATABASE_URL="postgresql://usuario:password@host.neon.tech/bithia_web?sslmode=require"

# --- Panel de administración ------------------------------------------------
# Correo con el que entra la dueña.
ADMIN_EMAIL="admin@bithiabrand.com"

# Hash bcrypt de la contraseña. NUNCA la contraseña en texto plano.
# Generalo con:  npm run admin:hash -- "tu-contraseña"
# El script lo imprime con los $ escapados como \$ — pégalo tal cual. Sin las
# barras, dotenv-expand se come el hash y el login rechaza la contraseña buena.
ADMIN_PASSWORD_HASH=""

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres).
# Generalo con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- Cloudinary (subida de fotos) -------------------------------------------
# Ambos valores son públicos: viajan al navegador. El API Secret NO se usa aquí
# porque las subidas son sin firmar (unsigned preset).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# --- WhatsApp ---------------------------------------------------------------
# Número de Bithia Brand en formato internacional, solo dígitos (51 = Perú).
NEXT_PUBLIC_WHATSAPP_NUMBER="51999999999"

# --- ERP (descuento automático de stock, opcional) --------------------------
# Sin estas dos variables, el pedido igual se manda por WhatsApp — solo no se
# avisa al ERP. Ver docs/integracion-erp-stock.md para el contrato completo.
ERP_STOCK_WEBHOOK_URL=""
ERP_STOCK_API_KEY=""
