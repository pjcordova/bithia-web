// Bithia Web — catálogo público + panel admin.
// Base de datos propia (Neon), sin ninguna conexión con el Postgres del ERP.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model productos {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Puente de verificación humana contra el ERP. Se muestra en el catálogo y
  // viaja en cada línea del mensaje de WhatsApp. Formato: VES-2508-03.
  codigo_lote       String   @unique
  nombre            String
  categoria         String
  color_principal   String
  // Hex del punto de color de la tarjeta (#RRGGBB). El nombre se conserva
  // porque el punto solo no sirve: sin texto no hay nada que leer para un
  // lector de pantalla ni para quien no distingue colores.
  color_hex         String?
  // Enlaza los colores de un mismo diseño. Las prendas que comparten este
  // valor se muestran como puntos de color intercambiables entre sí.
  // Es texto libre y no una tabla aparte porque cada colorway ya es un
  // producto completo, con su foto, su precio y sus tallas propias.
  grupo_variante    String?
  descripcion       String?
  precio_venta      Decimal  @db.Decimal(10, 2)
  // Foto de portada: la que sale en tarjetas, mosaicos y banda.
  imagen_url        String?
  // Fotos adicionales para la galería de la ficha. La galería completa es
  // [imagen_url, ...imagenes], así la portada siempre va primero.
  imagenes          String[] @default([])
  // Composición de la tela. Ej. "Lino 70%, viscosa 30%". Es de los datos que
  // más consultan por WhatsApp: ponerlo en la ficha ahorra esa conversación.
  material          String?
  // Ej. "Antonia mide 1.73 m (busto 85, cintura 62, cadera 87) y usa talla S".
  // Da escala: sin un cuerpo de referencia, las medidas en cm no dicen nada.
  referencia_modelo String?
  // Toggle manual del panel: oculta la prenda de la web sin borrar sus datos.
  visible_en_tienda Boolean  @default(true)
  // "Disponible / Agotado". La dueña lo marca a criterio propio — no hay
  // sincronización de stock con el ERP, es deliberado.
  disponible        Boolean  @default(true)
  // Aparece en "Los más pedidos" de la portada. No se calcula: no hay tabla de
  // pedidos que contar. Lo marca la dueña, que atiende cada pedido por
  // WhatsApp y sabe mejor que nadie qué sale más.
  destacado         Boolean  @default(false)
  // Protagoniza la banda de "Edición limitada" de la portada. Se muestra la
  // más reciente marcada, así que dejar varias encendidas no rompe nada.
  edicion_limitada  Boolean  @default(false)
  // Protagoniza la sección "Top de la semana". Igual que edicion_limitada,
  // gana la más reciente marcada.
  top_semana        Boolean  @default(false)
  // Protagoniza la segunda banda ancha, debajo de "Top de la semana".
  banner_inferior   Boolean  @default(false)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  tallas            tallas[]
  look_items        look_items[]

  @@index([categoria])
  @@index([created_at])
  @@index([grupo_variante])
}

// Un conjunto armado: la foto de la clienta con varias prendas puestas y los
// productos que la componen. Cambia con cada carga de mercadería, así que vive
// en la base y no en el código.
model looks {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo     String       @default("Chic Style")
  // Marca de agua vertical al costado de la foto. Es la firma de la casa, no
  // una consigna de campaña: por eso el nombre de la marca y no un lema.
  etiqueta   String?      @default("Bithia-Brand")
  imagen_url String
  activo     Boolean      @default(true)
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  items      look_items[]

  @@index([activo, created_at])
}

model look_items {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  look_id     String    @db.Uuid
  producto_id String    @db.Uuid
  // Posición del punto sobre la foto, en % del ancho y del alto. Sin valores
  // la prenda igual aparece en la lista de la derecha, solo que sin marcador.
  pos_x       Int?
  pos_y       Int?
  orden       Int       @default(0)
  looks       looks     @relation(fields: [look_id], references: [id], onDelete: Cascade)
  productos   productos @relation(fields: [producto_id], references: [id], onDelete: Cascade)

  @@unique([look_id, producto_id])
  @@index([look_id, orden])
}

// Qué tallas existen para esta prenda. Sin cantidad: el stock exacto vive
// solo en el ERP.
model tallas {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  producto_id String    @db.Uuid
  talla       String
  // Medidas de LA PRENDA en cm, no del cuerpo. Son referenciales y opcionales:
  // si no se cargan, la ficha simplemente no las muestra. Van en tallas y no
  // en productos porque cambian con cada talla, que es justo el dato que la
  // clienta necesita para decidir.
  busto_cm    Int?
  cintura_cm  Int?
  cadera_cm   Int?
  largo_cm    Int?
  productos   productos @relation(fields: [producto_id], references: [id], onDelete: Cascade)

  @@unique([producto_id, talla])
  @@index([producto_id])
}
